# Development defaults. For production set a strong POSTGRES_PASSWORD and JWT_SECRET, and SEED_DEMO_DATA=false.
POSTGRES_DB=mentora
POSTGRES_USER=mentora
POSTGRES_PASSWORD=mentora
JWT_SECRET=mentora-development-secret-key-change-me-0123456789abcdef
# Gemini (optional: everything except AI features works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest
# Demo data (set to false in production)
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_PORT=8081
# Timezone used for "today" in attendance (IANA name)
APP_TIMEZONE=Asia/Kolkata
